generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum NotificationType {
  CHALLENGE_CREATED
  SUBMISSION_RECEIVED
  SUBMISSION_EVALUATED
  SUBMISSION_REJECTED
  SUBMISSION_APPROVED
}

enum UserRole {
  COLLEGE
  STUDENT
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ChallengeStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  EVALUATED
  REJECT
}

enum SubmissionType {
  GITHUB_LINK
  FILE_UPLOAD
  BOTH
}

enum SkillCategory {
  PROGRAMMING
  FRONTEND
  BACKEND
  DATABASE
  DEVOPS
  TOOLS
}

enum SkillLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
}

enum Department {
  ALL
  BCA
  CSIT
  BIT
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?

  // One-to-one relations depending on the role
  college College?
  student Student?

  // Opposite relation for notifications
  notifications UserNotification[]

  @@map("users")
}

model College {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  name      String
  location  String?
  logo      String?
  phone     String?
  about     String?
  stamp     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenges Challenge[]

  @@map("colleges")
}

model Student {
  id                 String        @id @default(uuid()) @db.Uuid
  userId             String        @unique @map("user_id") @db.Uuid
  studentId          String?       @unique @map("student_id")
  profile            String
  name               String
  batch              Int
  department         String
  status             StudentStatus @default(ACTIVE)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  mustChangePassword Boolean       @default(true) @map("must_change_password")
  isVerified         Boolean       @default(false) @map("is_verified")

  phone      String?
  location   String?
  headline   String?
  about      String? @db.Text
  university String?

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions    Submission[]
  skills         StudentSkill[]
  participations ChallengeParticipate[]

  @@index([department])
  @@index([batch])
  @@index([status])
  @@map("students")
}

model Challenge {
  id           String     @id @default(uuid()) @db.Uuid
  collegeId    String?    @map("college_id") @db.Uuid
  title        String
  description  String
  instructions String
  difficulty   Difficulty

  startDate DateTime @map("start_date")
  deadline  DateTime

  submissionType SubmissionType  @map("submission_type")
  status         ChallengeStatus @default(DRAFT)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  college        College?               @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  submissions    Submission[]
  skills         ChallengeSkill[]
  participations ChallengeParticipate[]
  departments    Department[]           @map("departments")
  notifications  Notification[]
  rubrics        Rubric[]

  @@index([collegeId])
  @@index([status])
  @@index([startDate])
  @@index([deadline])
  @@map("challenges")
}

model Skill {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @unique
  category  SkillCategory
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  challenges ChallengeSkill[]
  students   StudentSkill[]

  @@index([category])
  @@map("skills")
}

model ChallengeSkill {
  id          String @id @default(uuid()) @db.Uuid
  challengeId String @map("challenge_id") @db.Uuid
  skillId     String @map("skill_id") @db.Uuid

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([challengeId, skillId])
  @@index([skillId])
  @@map("challenge_skills")
}

model Submission {
  id          String           @id @default(uuid()) @db.Uuid
  studentId   String           @map("student_id") @db.Uuid
  challengeId String           @map("challenge_id") @db.Uuid
  githubLink  String?          @map("github_link")
  description String?
  status      SubmissionStatus @default(SUBMITTED)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  challenge     Challenge      @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  evaluation    Evaluation?
  notifications Notification[]

  @@unique([studentId, challengeId])
  @@index([studentId])
  @@index([challengeId])
  @@index([status])
  @@map("student_submissions")
}

model Evaluation {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @unique @map("submission_id") @db.Uuid
  total        Int
  feedback     String?
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  submission Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  scores     RubricScore[]

  @@map("evaluations")
}

model StudentSkill {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillId])
  @@index([skillId])
  @@map("student_skills")
}

model ChallengeParticipate {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  challengeId String   @map("challenge_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([studentId, challengeId])
  @@index([studentId])
  @@index([challengeId])
  @@map("challenge_participations")
}

model Rubric {
  id          String   @id @default(uuid()) @db.Uuid
  challengeId String   @map("challenge_id") @db.Uuid
  name        String
  description String?
  maxScore    Int      @map("max_score")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  challenge Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  scores    RubricScore[]

  @@index([challengeId])
  @@map("rubrics")
}

model RubricScore {
  id           String  @id @default(uuid()) @db.Uuid
  evaluationId String  @map("evaluation_id") @db.Uuid
  rubricId     String  @map("rubric_id") @db.Uuid
  score        Int
  feedback     String?

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  rubric     Rubric     @relation(fields: [rubricId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, rubricId])
  @@index([rubricId])
  @@map("rubric_scores")
}

model Notification {
  id           String           @id @default(cuid())
  type         NotificationType
  title        String
  message      String
  challengeId  String?          @map("challenge_id") @db.Uuid
  submissionId String?          @map("submission_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")

  challenge  Challenge?  @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  recipients UserNotification[]

  @@index([challengeId])
  @@index([submissionId])
  @@map("notifications")
}

model UserNotification {
  id             String @id @default(cuid())
  userId         String @map("user_id") @db.Uuid
  notificationId String @map("notification_id")

  isRead Boolean   @default(false) @map("is_read")
  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId, isRead])
  @@index([notificationId])
  @@map("user_notifications")
}
